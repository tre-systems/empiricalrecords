# empirical records - Apache configuration

# --- Preserved from JustHost/cPanel (do not remove) ---
DirectoryIndex index.html index.htm

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php80" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# --- Security hardening ---

# Prevent directory browsing
Options -Indexes

# Block access to sensitive files
<FilesMatch "(^\.env|^\.htaccess|\.bak$|\.log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- empirical records site config ---

# Enable mod_rewrite
RewriteEngine On

# --- Clean URL redirects (301) ---
# Redirect .html extensions to clean URLs
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} /artist-csu\.html [NC]
RewriteRule ^artist-csu\.html$ /artist-csu [R=301,L]

RewriteCond %{THE_REQUEST} /artist-multivibrator\.html [NC]
RewriteRule ^artist-multivibrator\.html$ /artist-multivibrator [R=301,L]

RewriteCond %{THE_REQUEST} /artist-uv\.html [NC]
RewriteRule ^artist-uv\.html$ /artist-uv [R=301,L]

RewriteCond %{THE_REQUEST} /artist-dsb\.html [NC]
RewriteRule ^artist-dsb\.html$ /artist-dsb [R=301,L]

# --- Clean URL rewriting ---
# Serve .html files for clean URLs
# ONLY matches our specific artist pages — does not affect subfolders
RewriteRule ^artist-csu$ artist-csu.html [L]
RewriteRule ^artist-multivibrator$ artist-multivibrator.html [L]
RewriteRule ^artist-uv$ artist-uv.html [L]
RewriteRule ^artist-dsb$ artist-dsb.html [L]

# --- Custom 404 ---
ErrorDocument 404 /404.html

# --- Security headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Cache control ---
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML pages - no cache
    ExpiresByType text/html "access plus 0 seconds"

    # CSS/JS - 1 year (cache-busted via ?v2)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Images - 1 year
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Audio - 1 year
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/ogg "access plus 1 year"

    # XML - 1 hour
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # HTML - always revalidate
    <FilesMatch "\.(html)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # Static assets - long cache
    <FilesMatch "\.(css|js|gif|jpg|jpeg|png|webp|ico|mp3|ogg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # robots.txt and sitemap
    <FilesMatch "(robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
